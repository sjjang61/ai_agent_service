# App
APP_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=super_agent

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=

# LLM Providers
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=
GOOGLE_API_KEY=
# LLM 선택: pet | openai | gemini | anthropic  (기본: pet)
LLM_TYPE=pet

# LLM_TYPE 별 모델 (pet 은 아래 PET_MODEL_ID 사용)
OPENAI_MODEL=gpt-6-luna
# gpt-5 계열 등 reasoning 모델 + tool 사용 시 none 필요. gpt-4o 등은 빈 값 (미전송)
OPENAI_REASONING_EFFORT=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-sonnet-4-5

# Agent
AGENT_MAX_ITERATIONS=25
AGENT_TIMEOUT_SECONDS=300
AGENT_MEMORY_WINDOW=20
# 에이전트 엔진: agno (멀티에이전트 Team: Research/Coder/MCP 위임) | langgraph (단일 ReAct 에이전트)
AGENT_ENGINE=agno
# MCP 도구 노출: lazy (목록만 프롬프트에 두고 load_mcp_tool/call_mcp_tool/run_mcp_code 로 사용) | direct (모든 MCP 도구를 개별 등록)
MCP_TOOL_MODE=lazy
# 브라우저 에이전트(cli_browser_agent) 한도
BROWSER_MAX_STEPS=30
BROWSER_TIMEOUT_SECONDS=300

# PetAgent (사내 LLM — OpenAI-compatible)
PET_AGENT_URL=http://your-pet-agent-server/v1
PET_MODEL_ID=your-model-id
PET_API_KEY=NONE
PET_TIMEOUT=60
PET_MCP_SERVER_URL=
# reasoning 모델 + tool 사용 시 none 필요 (gpt-5 계열 400 에러 방지). 빈 값이면 미전송
PET_REASONING_EFFORT=none
# PetAgent 서버가 SSE 스트리밍을 지원하면 true (기본 false: 완료 후 한 번에 전달)
PET_STREAMING=false

# Tools
TAVILY_API_KEY=
SERPAPI_KEY=
CRAWLER_HEADLESS=true
CRAWLER_TIMEOUT_MS=30000

# Sandbox
SANDBOX_IMAGE=ai-agent-sandbox:latest
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_NETWORK=sandbox-network
SANDBOX_TTL_HOURS=24
SANDBOX_POOL_MIN=3
SANDBOX_POOL_MAX=50

# Sandbox 백업 (MinIO) — MINIO_ENDPOINT 가 비어 있으면 자동 백업/종료 기능이 꺼집니다
# 유휴 5분 이상 미사용 시 /workspace 를 MinIO 의 {세션id}/workspace.tar.gz 로 백업 후 종료하고,
# 같은 세션으로 다시 요청하면 백업에서 복구합니다.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=sandbox-sessions
SANDBOX_IDLE_MINUTES=5
SANDBOX_REAPER_INTERVAL_SECONDS=60
SANDBOX_BACKUP_MAX_MB=1024

# 파일 도구 (공개 다운로드 링크 / URL 다운로드)
# 공개 링크에 붙는 백엔드 외부 접근 주소 (배포 시 실제 도메인으로 변경)
PUBLIC_BASE_URL=http://localhost:8500
PUBLISH_EXPIRE_HOURS=24
PUBLISH_MAX_MB=100
DOWNLOAD_MAX_MB=50
# 채팅 첨부 파일 업로드 (sandbox /workspace/uploads/) 파일당 최대 크기
UPLOAD_MAX_MB=50

# 예약 작업 (스케줄러)
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30
SCHEDULER_MAX_CONCURRENT=3
# 서버 중단 등으로 이 시간(초)보다 늦은 회차는 실행하지 않고 건너뜀
SCHEDULER_MISFIRE_GRACE_SECONDS=3600
SCHEDULER_RUN_TIMEOUT_SECONDS=600
SCHEDULER_MAX_TASKS_PER_USER=10
# 연속 실패 시 자동 일시중지
SCHEDULER_MAX_CONSECUTIVE_FAILURES=3
SCHEDULER_MIN_INTERVAL_HOURS=1
SCHEDULER_DEFAULT_TIMEZONE=Asia/Seoul

# 이미지 생성(generate_image) · 공개 업로드(upload_to_minio): 결과를 공개 읽기 버킷에 올려 공개 URL 로 접근한다
# 같은 MinIO 서버(위 MINIO_*)를 쓰되 버킷은 별도이며 익명 읽기가 열린다. 비밀 파일을 올리지 말 것.
IMAGE_GENERATION_ENABLED=true
OPENAI_IMAGE_MODEL=gpt-image-2
IMAGE_DEFAULT_SIZE=1024x1024
IMAGE_DAILY_LIMIT=30
MINIO_PUBLIC_BUCKET=agent-public
# 브라우저가 MinIO 에 접근하는 주소. 비워 두면 MINIO_ENDPOINT 로 만든다 (운영에서는 외부 주소로 지정)
MINIO_PUBLIC_URL=http://localhost:29000

# 동영상 생성(generate_video): Google Gemini Omni (Interactions API). GOOGLE_API_KEY 를 쓰고, 영상은 이미지와 같은 공개 버킷(MINIO_PUBLIC_BUCKET)에 올린다
# 영상은 시간(수 분)과 비용이 크다. 해상도: 360p(초안용 저가) | 720p | 1080p | 4k
VIDEO_GENERATION_ENABLED=true
# 영상 전용 Gemini API 키 (비워 두면 GOOGLE_API_KEY 를 쓴다)
VIDEO_API_KEY=
VIDEO_MODEL=gemini-omni-1.1-flash
VIDEO_RESOLUTION=360p
VIDEO_ASPECT_RATIO=16:9
VIDEO_DEFAULT_SECONDS=6
# true 면 ffmpeg 로 오디오 트랙을 제거한다 (ffmpeg 가 없으면 경고만 남기고 원본 사용)
VIDEO_STRIP_AUDIO=false
VIDEO_DAILY_LIMIT=5

# 단기 메모리(대화방별 임시 메모리) 유지 시간(초). 저장·갱신할 때마다 다시 시작한다 (기본 7일)
SHORT_TERM_MEMORY_TTL=604800

# 토큰 사용량의 예상 비용 계산: 기본 단가표(services/pricing.py, OpenAI Standard) 외 모델을 더하거나 덮어쓴다. {"모델": [입력, 캐시 입력 또는 null, 출력]} (USD/1M tokens)
MODEL_PRICES_JSON=

# 웹앱 배포(deploy_web_app): 불변 아카이브 + 앱 전용 컨테이너 + 프록시 포트(요청 시 자동 시작)
APP_HOST_ENABLED=true
APP_PORT_START=20000
APP_PORT_END=20099
# 프록시 리스너 바인드 주소. 원격 서버에서 외부에 열려면 0.0.0.0 (방화벽에서 포트 범위를 열고 APP_REQUIRE_TOKEN=true 권장)
APP_BIND_HOST=127.0.0.1
# 앱 URL 에 쓰는 호스트명 (브라우저가 접근하는 주소)
APP_PUBLIC_HOST=localhost
APP_REQUIRE_TOKEN=false
APP_MAX_PER_USER=5
APP_ARTIFACT_MAX_MB=200
APP_IDLE_MINUTES=10

# 공개 앱(App Store): 포트 하나(APP_PUBLIC_PORT)에서 Host 헤더({slug}.APP_PUBLIC_DOMAIN)로 앱을 구분한다.
# 로컬은 *.localhost 가 브라우저에서 127.0.0.1 로 풀린다 (Safari 는 풀리지 않을 수 있음). 운영은 와일드카드 DNS(*.apps.example.com)와 TLS 필요
APP_PUBLIC_PORT=20100
APP_PUBLIC_DOMAIN=localhost
APP_PUBLIC_SCHEME=http
APP_PUBLIC_BIND=
APP_MAX_RUNNING=20
APP_PUBLIC_RATE_PER_MIN=600
APP_PUBLIC_WAKE_PER_MIN=6
APP_REPORT_SUSPEND_THRESHOLD=3
# App Store 검수·정지 권한을 가진 관리자 이메일 (쉼표로 구분)
ADMIN_EMAILS=
