# App
APP_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=super_agent

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=

# LLM Providers
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=
GOOGLE_API_KEY=
# LLM 선택: pet | openai | gemini | anthropic  (기본: pet)
LLM_TYPE=pet

# LLM_TYPE 별 모델 (pet 은 아래 PET_MODEL_ID 사용)
OPENAI_MODEL=gpt-6-luna
# gpt-5 계열 등 reasoning 모델 + tool 사용 시 none 필요. gpt-4o 등은 빈 값 (미전송)
OPENAI_REASONING_EFFORT=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-sonnet-4-5

# Agent
AGENT_MAX_ITERATIONS=25
AGENT_TIMEOUT_SECONDS=300
AGENT_MEMORY_WINDOW=20
# 에이전트 엔진: agno (멀티에이전트 Team: Research/Coder/MCP 위임) | langgraph (단일 ReAct 에이전트)
AGENT_ENGINE=agno
# MCP 도구 노출: lazy (목록만 프롬프트에 두고 load_mcp_tool/call_mcp_tool/run_mcp_code 로 사용) | direct (모든 MCP 도구를 개별 등록)
MCP_TOOL_MODE=lazy
# 브라우저 에이전트(cli_browser_agent) 한도
BROWSER_MAX_STEPS=30
BROWSER_TIMEOUT_SECONDS=300
# 여러 사이트 비교 등 병렬 브라우저 작업의 최대 동시 탭 수 (로컬 브라우저 전용, 앱도 같은 값으로 제한)
BROWSER_PARALLEL_MAX=3
# 로컬 브라우저(데스크톱 앱 내장 브라우저, ai_agent_desktop). 서버가 사용자 PC 에서 돌 때만 사용
# LOCAL_BROWSER_CDP_URL=http://127.0.0.1:9222
# LOCAL_BROWSER_USER_ID=<로컬 브라우저를 쓸 사용자 id>
# LOCAL_BROWSER_ALLOW_PRIVATE=false
# 브라우저 안전 정책: 쓰기 동작(폼 제출·버튼 클릭) 승인 범위 local(기본: 로컬 브라우저만) | all | off
# BROWSER_APPROVAL_MODE=local
# BROWSER_BLOCKED_DOMAINS=["evil.com"]
# BROWSER_ALLOWED_DOMAINS=[]
# BROWSER_SENSITIVE_DOMAINS=["mybank.co.kr"]

# PetAgent (사내 LLM — OpenAI-compatible)
PET_AGENT_URL=http://your-pet-agent-server/v1
PET_MODEL_ID=your-model-id
PET_API_KEY=NONE
PET_TIMEOUT=60
PET_MCP_SERVER_URL=
# reasoning 모델 + tool 사용 시 none 필요 (gpt-5 계열 400 에러 방지). 빈 값이면 미전송
PET_REASONING_EFFORT=none
# PetAgent 서버가 SSE 스트리밍을 지원하면 true (기본 false: 완료 후 한 번에 전달)
PET_STREAMING=false

# Tools
TAVILY_API_KEY=
SERPAPI_KEY=
CRAWLER_HEADLESS=true
CRAWLER_TIMEOUT_MS=30000

# Sandbox
SANDBOX_IMAGE=ai-agent-sandbox:latest
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_NETWORK=sandbox-network
SANDBOX_TTL_HOURS=24
SANDBOX_POOL_MIN=3
SANDBOX_POOL_MAX=50

# Sandbox 백업 (MinIO) — MINIO_ENDPOINT 가 비어 있으면 자동 백업/종료 기능이 꺼집니다
# 유휴 5분 이상 미사용 시 /workspace 를 MinIO 의 {세션id}/workspace.tar.gz 로 백업 후 종료하고,
# 같은 세션으로 다시 요청하면 백업에서 복구합니다.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=sandbox-sessions
SANDBOX_IDLE_MINUTES=5
SANDBOX_REAPER_INTERVAL_SECONDS=60
SANDBOX_BACKUP_MAX_MB=1024

# 파일 도구 (공개 다운로드 링크 / URL 다운로드)
# 공개 링크에 붙는 백엔드 외부 접근 주소 (배포 시 실제 도메인으로 변경)
PUBLIC_BASE_URL=http://localhost:8500
PUBLISH_EXPIRE_HOURS=24
PUBLISH_MAX_MB=100
DOWNLOAD_MAX_MB=50
# 채팅 첨부 파일 업로드 (sandbox /workspace/uploads/) 파일당 최대 크기
UPLOAD_MAX_MB=50

# 예약 작업 (스케줄러)
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30
SCHEDULER_MAX_CONCURRENT=3
# 서버 중단 등으로 이 시간(초)보다 늦은 회차는 실행하지 않고 건너뜀
SCHEDULER_MISFIRE_GRACE_SECONDS=3600
SCHEDULER_RUN_TIMEOUT_SECONDS=600
SCHEDULER_MAX_TASKS_PER_USER=10
# 연속 실패 시 자동 일시중지
SCHEDULER_MAX_CONSECUTIVE_FAILURES=3
SCHEDULER_MIN_INTERVAL_HOURS=1
SCHEDULER_DEFAULT_TIMEZONE=Asia/Seoul

# 이미지 생성(generate_image) · 공개 업로드(upload_to_minio): 결과를 공개 읽기 버킷에 올려 공개 URL 로 접근한다
# 같은 MinIO 서버(위 MINIO_*)를 쓰되 버킷은 별도이며 익명 읽기가 열린다. 비밀 파일을 올리지 말 것.
IMAGE_GENERATION_ENABLED=true
OPENAI_IMAGE_MODEL=gpt-image-2
IMAGE_DEFAULT_SIZE=1024x1024
IMAGE_DAILY_LIMIT=30
MINIO_PUBLIC_BUCKET=agent-public
# 브라우저가 MinIO 에 접근하는 주소. 비워 두면 MINIO_ENDPOINT 로 만든다 (운영에서는 외부 주소로 지정)
MINIO_PUBLIC_URL=http://localhost:29000

# 동영상 생성(generate_video): Google Gemini Omni (Interactions API). GOOGLE_API_KEY 를 쓰고, 영상은 이미지와 같은 공개 버킷(MINIO_PUBLIC_BUCKET)에 올린다
# 영상은 시간(수 분)과 비용이 크다. 해상도: 360p(초안용 저가) | 720p | 1080p | 4k
VIDEO_GENERATION_ENABLED=true
# 영상 전용 Gemini API 키 (비워 두면 GOOGLE_API_KEY 를 쓴다)
VIDEO_API_KEY=
VIDEO_MODEL=gemini-omni-1.1-flash
VIDEO_RESOLUTION=360p
VIDEO_ASPECT_RATIO=16:9
VIDEO_DEFAULT_SECONDS=6
# true 면 ffmpeg 로 오디오 트랙을 제거한다 (ffmpeg 가 없으면 경고만 남기고 원본 사용)
VIDEO_STRIP_AUDIO=false
VIDEO_DAILY_LIMIT=5

# 단기 메모리(대화방별 임시 메모리) 유지 시간(초). 저장·갱신할 때마다 다시 시작한다 (기본 7일)
SHORT_TERM_MEMORY_TTL=604800

# 토큰 사용량의 예상 비용 계산: 기본 단가표(services/pricing.py, OpenAI Standard) 외 모델을 더하거나 덮어쓴다. {"모델": [입력, 캐시 입력 또는 null, 출력]} (USD/1M tokens)
MODEL_PRICES_JSON=

# 웹앱 배포(deploy_web_app): 불변 아카이브 + 앱 전용 컨테이너 + 프록시 포트(요청 시 자동 시작)
APP_HOST_ENABLED=true
APP_PORT_START=20000
APP_PORT_END=20099
# 프록시 리스너 바인드 주소. 원격 서버에서 외부에 열려면 0.0.0.0 (방화벽에서 포트 범위를 열고 APP_REQUIRE_TOKEN=true 권장)
APP_BIND_HOST=127.0.0.1
# 앱 URL 에 쓰는 호스트명 (브라우저가 접근하는 주소)
APP_PUBLIC_HOST=localhost
APP_REQUIRE_TOKEN=false
# 사용자당 My Apps 에 둘 수 있는 앱 최대 수 (시작에 실패한 앱도 센다. 넘으면 새 앱을 배포할 수 없다)
APP_MAX_PER_USER=10
APP_ARTIFACT_MAX_MB=200
APP_IDLE_MINUTES=10

# 공개 앱(App Store): 포트 하나(APP_PUBLIC_PORT)에서 Host 헤더({slug}.APP_PUBLIC_DOMAIN)로 앱을 구분한다.
# 로컬은 *.localhost 가 브라우저에서 127.0.0.1 로 풀린다 (Safari 는 풀리지 않을 수 있음). 운영은 와일드카드 DNS(*.apps.example.com)와 TLS 필요
APP_PUBLIC_PORT=20100
APP_PUBLIC_DOMAIN=localhost
APP_PUBLIC_SCHEME=http
APP_PUBLIC_BIND=
APP_MAX_RUNNING=20
APP_PUBLIC_RATE_PER_MIN=600
APP_PUBLIC_WAKE_PER_MIN=6
APP_REPORT_SUSPEND_THRESHOLD=3
# App Store 검수(승인·반려·정지) 권한. 사용자 역할이 생기기 전에는 로그인한 모든 사용자가 검수할 수 있다.
# 역할을 도입하면 APP_REVIEW_OPEN_TO_ALL=false 로 바꾸고 ADMIN_EMAILS(쉼표로 구분)에 검수자를 적는다
APP_REVIEW_OPEN_TO_ALL=true
# false 면 자기 앱은 직접 승인·반려할 수 없다
APP_REVIEW_ALLOW_SELF=true
ADMIN_EMAILS=

# Google Workspace 커넥터 (Gmail·Calendar·Drive·Docs·Sheets·Slides): 사용자가 커넥터 화면에서 자기 Google 계정으로 연결한다.
# Google Cloud 콘솔 > API 및 서비스 > 사용자 인증 정보에서 'OAuth 클라이언트 ID(웹 애플리케이션)'를 만들고, 승인된 리디렉션 URI 에
# GOOGLE_OAUTH_REDIRECT_URI (비우면 {PUBLIC_BASE_URL}/api/connectors/google/callback) 를 등록한다. 각 서비스의 API(Gmail API, Google Calendar API,
# Google Drive API, Google Docs API, Google Sheets API, Google Slides API)도 같은 프로젝트에서 사용 설정해야 한다.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# 에이전트 응답 모니터링 (트레이스·지연·토큰·오류). none | opik | langfuse — OpenTelemetry(OTLP)로 보내므로 값만 바꾸면 도구가 바뀐다 ('opic' 오타도 opik 으로 받는다).
# 프롬프트·도구 결과 전문을 그대로 저장하므로 자체 호스팅 서버만 쓴다. Opik 은 infra/monitoring/opik (docker compose --profile opik up -d, 화면 http://localhost:15174).
AGENT_MONITORING_TYPE=none
MONITORING_SERVICE_NAME=ai-agent-backend
# 트레이스 표본 비율 0~1 (1 = 전부)
MONITORING_SAMPLE_RATE=1.0
# 스팬당 최대 속성 수 (긴 대화에서 'Attributes dict is full' 경고가 나면 늘린다)
MONITORING_MAX_SPAN_ATTRIBUTES=2000
# LangChain 직접 호출(라우터·메모리 추출·위키 등)과 LangGraph 엔진까지 기록. Agno 경로에서는 도구 호출 스팬이 중복되므로 기본은 false
MONITORING_LANGCHAIN=false
OPIK_URL=http://localhost:15174
OPIK_PROJECT_NAME=ai-agent-platform
# Opik Cloud 전용 (자체 호스팅은 비워 둔다)
OPIK_WORKSPACE=default
OPIK_API_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 대화 공유 (채팅 우측 상단 '공유': 로그인 없이 읽는 링크)
# 0 이면 공유를 해제할 때까지 유효, 양수면 공유(업데이트)한 날부터 이 일수 뒤 링크가 끊긴다
SHARE_EXPIRE_DAYS=0
# 한 번에 공유할 최대 메시지 수(최근 것부터)와, 공유 링크 조회 제한(IP 당 분당, 0 이면 제한 없음)
SHARE_MAX_MESSAGES=500
SHARE_RATE_PER_MIN=60
# 프런트엔드(.env): 링크의 주소가 현재 접속 주소와 다를 때(데스크톱 앱 등) VITE_SHARE_BASE_URL=https://서비스주소

# Drive: 사용자별 개인 파일 공간 (MinIO 비공개 버킷 + DB 폴더 트리). MINIO_ENDPOINT / ACCESS_KEY / SECRET_KEY 가 설정되어 있어야 켜진다
DRIVE_ENABLED=true
MINIO_DRIVE_BUCKET=agent-drive
# 파일 1개 최대 크기(MB)와 사용자당 총량(GB). 리버스 프록시의 client_max_body_size 는 DRIVE_MAX_FILE_MB 보다 커야 한다 (infra/nginx/nginx.conf)
DRIVE_MAX_FILE_MB=200
DRIVE_QUOTA_GB=5
DRIVE_MAX_DEPTH=20
DRIVE_MAX_CHILDREN=10000
# 휴지통 보관 일수 (0 이면 자동 영구 삭제 안 함)
DRIVE_TRASH_RETENTION_DAYS=30
# sandbox → Drive 저장: 한 번에 저장할 최대 크기(MB)·파일 수 / Drive → sandbox 불러오기 최대 크기(MB)
DRIVE_IMPORT_MAX_MB=500
DRIVE_IMPORT_MAX_FILES=2000
DRIVE_LOAD_MAX_MB=50
DRIVE_UPLOADS_PER_MIN=120

# Functions (Lambda 형 실행): zip 패키지를 실행할 때마다 새 격리 컨테이너에서 돌리고 폐기한다. 기본은 꺼져 있다
# 켜기 전: infra/functions/build.sh 로 런타임 이미지를 만들고, MinIO 설정(위)이 되어 있어야 한다. 네트워크는 항상 차단된다
FUNCTION_ENABLED=false
# 사용 허용 이메일(쉼표 구분, '*' 는 모든 로그인 사용자). 관리자(ADMIN_EMAILS)는 항상 허용
FUNCTION_ALLOWED_EMAILS=
FUNCTION_RUNTIME_IMAGE_PYTHON=ai-agent-fn-python:latest
FUNCTION_RUNTIME_IMAGE_BUN=ai-agent-fn-bun:latest
# 동시 실행 한도(사용자당/전체), 사용자당 대기열·일일 실행 수
FUNCTION_MAX_CONCURRENT_PER_USER=3
FUNCTION_MAX_CONCURRENT_GLOBAL=20
FUNCTION_QUEUE_MAX_PER_USER=20
FUNCTION_RUNS_PER_DAY_PER_USER=500
# 패키지·입출력·로그 한도, 타임아웃(초)·메모리(MB) 기본/최대
FUNCTION_PACKAGE_MAX_MB=50
FUNCTION_UNPACKED_MAX_MB=250
FUNCTION_EVENT_MAX_KB=256
FUNCTION_RESULT_MAX_KB=1024
FUNCTION_LOG_MAX_KB=1024
FUNCTION_TIMEOUT_DEFAULT=30
FUNCTION_TIMEOUT_MAX=900
FUNCTION_MEMORY_DEFAULT_MB=256
FUNCTION_MEMORY_MAX_MB=1024
# 동기 호출이 결과를 기다리는 최대 시간(초), 실행 이력·로그 보존 일수(0 이면 자동 삭제 안 함)
FUNCTION_SYNC_WAIT_SECONDS=30
FUNCTION_RUN_RETENTION_DAYS=30
# 사용자당 예약·웹훅 트리거 수, 웹훅 호출 제한(토큰당·IP 당 분당), 함수 하나의 버전 수
FUNCTION_TRIGGERS_MAX_PER_USER=20
FUNCTION_WEBHOOK_RATE_PER_MIN=60
FUNCTION_VERSIONS_MAX=50

# 음성 생성(generate_speech): OpenAI Realtime 모델로 글을 읽어 작업공간에 WAV 로 저장한다 (공개 업로드 없음)
# 목소리를 고르지 않으면 SPEECH_DEFAULT_VOICE(marin)로 바로 만들고, 사용자가 고르고 싶어 하면 SPEECH_VOICES(marin, cedar) 샘플을 들려 준다
SPEECH_GENERATION_ENABLED=true
# realtime(권장) | speech_api (/v1/audio/speech: tts 모델이 2027-01-06 에 종료되므로 임시 예비용)
SPEECH_PROVIDER=realtime
OPENAI_SPEECH_MODEL=gpt-realtime-2.1-mini
SPEECH_FORMAT=mp3
SPEECH_DEFAULT_VOICE=marin
SPEECH_VOICES=marin,cedar
# 한 번에 읽을 최대 글자 수, 덩어리 크기, 미리듣기 글자 수, 사용자당 하루 생성 횟수(0 이면 제한 없음)
SPEECH_MAX_CHARS=3000
SPEECH_CHUNK_CHARS=500
SPEECH_PREVIEW_CHARS=140
SPEECH_DAILY_LIMIT=30
